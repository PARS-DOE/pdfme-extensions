{
  "name": "@pars-doe/pdfme-extensions",
  "version": "1.0.0",
  "sideEffects": false,
  "author": "Craig Haseler",
  "license": "CC0-1.0",
  "keywords": [
    "pdf",
    "pdf-generation",
    "pdf-designer",
    "pdf-viewer",
    "typescript",
    "react",
    "enhanced-schemas",
    "reporting",
    "conditional-formatting"
  ],
  "description": "Extended schemas for PDFme with enhanced formatting capabilities. Developed by the US Department of Energy as an open-source extension to the PDFme library.",
  "homepage": "https://github.com/PARS-DOE/pdfme-extensions",
  "repository": {
    "type": "git",
    "url": "git@github.com:PARS-DOE/pdfme-extensions.git"
  },
  "bugs": {
    "url": "https://github.com/PARS-DOE/pdfme-extensions/issues"
  },
  "main": "dist/cjs/src/index.js",
  "module": "dist/esm/src/index.js",
  "types": "dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/src/index.js",
      "require": "./dist/cjs/src/index.js"
    },
    "./utils": {
      "import": "./dist/esm/src/utils.js",
      "require": "./dist/cjs/src/utils.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.esm.json -w",
    "build": "npm-run-all --parallel build:cjs build:esm build:node",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:node": "tsc -p tsconfig.node.json",
    "clean": "rimraf dist",
    "lint": "eslint --ext .ts src --config eslint.config.mjs",
    "test": "jest",
    "prune": "ts-prune src",
    "prettier": "prettier --write 'src/**/*.ts'"
  },
  "dependencies": {
    "air-datepicker": "^3.5.3",
    "bwip-js": "^4.1.1",
    "date-fns": "^4.1.0",
    "fontkit": "^2.0.2",
    "lucide": "^0.477.0"
  },
  "devDependencies": {
    "@pdfme/common": "file:../common",
    "@pdfme/pdf-lib": "*",
    "@types/bwip-js": "^3.2.1",
    "@types/fontkit": "^2.0.4",
    "@types/pngjs": "^6.0.2",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0"
  },
  "peerDependencies": {
    "@pdfme/common": "^5.3.0",
    "pdf-lib": "^1.17.1"
  },
  "jest": {
    "resolver": "ts-jest-resolver",
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "transform": {
      "^.+\\.ts?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.esm.json"
        }
      ]
    },
    "testMatch": [
      "**/*.test.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
